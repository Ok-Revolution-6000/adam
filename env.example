# Adomeh — copy to .env.local (gitignored). The same names go on the Vercel project for production.
# Clerk (application "Adomeh"): `clerk env pull` writes the two keys below for the dev instance.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_…
CLERK_SECRET_KEY=sk_test_…
# Optional: the instance's JWKS public key (PEM) lets api/ verify tokens without a network call.
CLERK_JWT_KEY=
# Stripe (account acct_1UIQU7AQYpTIzF1r, test mode first)
STRIPE_SECRET_KEY=sk_test_…
STRIPE_WEBHOOK_SECRET=whsec_…
STRIPE_PRICE_MONTH=price_…
STRIPE_PRICE_YEAR=price_…
# Cloudflare R2: the private corpus bucket api/content.ts reads and scripts/sync-corpus.mjs writes
R2_ACCOUNT_ID=
R2_BUCKET=adomeh-corpus
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Where Stripe sends people back to; never derived from the request
APP_ORIGIN=http://localhost:3020
